# RankEngine AI - Environment Configuration Example

# General Settings
PROJECT_NAME="RankEngine AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-very-secure-random-string-at-least-32-chars

# PostgreSQL Database (Async)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rankengine_db
# Optional override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rankengine_db

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Google PageSpeed Insights & Google Places API
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# LLM API (OpenAI / DeepSeek / Compatible endpoint)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

# Scraping & Headless Browser
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT_MS=30000
